{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScholarNoteLM",
  "version": "0.6.4",
  "identifier": "com.scholarnotelm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../../dist/ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScholarNoteLM",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' blob:; worker-src 'self' blob:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "A connected workspace for literature research",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
