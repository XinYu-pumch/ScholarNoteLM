  {
    "id": "qwen_openai",
    "name": "Qwen 3.8 · Chat Completions",
    "protocol": "chat",
    "levels": [
      "default",
      "enabled",
      "disabled",
      "low",
      "medium",
      "xhigh",
      "budget"
    ],
    "defaultLevel": "default",
    "options": {
      "default": {},
      "enabled": {
        "enable_thinking": true
      },
      "disabled": {
        "enable_thinking": false
      },
      "low": {
        "enable_thinking": true,
        "reasoning_effort": "low"
      },
      "medium": {
        "enable_thinking": true,
        "reasoning_effort": "medium"
      },
      "xhigh": {
        "enable_thinking": true,
        "reasoning_effort": "xhigh"
      },
      "budget": {
        "enable_thinking": true
      }
    },
    "omitTemperature": false,
    "note": "Qwen 3.8: low/medium/xhigh, or an exclusive thinking token budget (0–262144). Never send effort and budget together. Server defaults: xhigh / 131072 tokens; 0 budget is not the disabled switch. Existing default mode follows the service.",
    "sources": [
      "https://help.aliyun.com/en/model-studio/qwen-api-via-openai-chat-completions"
    ],
    "output": {
      "modes": [
        "default"
      ],
      "note": "思考模式通常自动通过 reasoning_content 返回推理文本；不额外发送摘要参数。",
      "kind": "reasoning_text",
      "defaultMode": "default"
    },
    "budget": {
      "min": 0,
      "max": 262144,
      "default": 131072,
      "field": "thinking_budget"
    }
  },
