[
  {
    "id": "gemini4_openai",
    "name": "Gemini 4 · OpenAI Compatible",
    "protocol": "chat",
    "levels": [
      "low",
      "medium",
      "high"
    ],
    "defaultLevel": "medium",
    "source": "https://ai.google.dev/gemini-api/docs/openai#thinking",
    "options": {
      "low": {
        "reasoning_effort": "low"
      },
      "medium": {
        "reasoning_effort": "medium"
      },
      "high": {
        "reasoning_effort": "high"
      }
    },
    "output": {
      "modes": [
        "default",
        "summary",
        "off"
      ],
      "note": "可显式请求思考摘要。使用 Google 的 Chat Completions 扩展字段；第三方中转站可能不支持。服务端默认保留原请求。",
      "kind": "summary",
      "defaultMode": "summary"
    }
  },
  {
    "id": "gemini4_native",
    "name": "Gemini 4 · Native",
    "protocol": "google",
    "levels": [
      "low",
      "medium",
      "high"
    ],
    "defaultLevel": "medium",
    "source": "https://ai.google.dev/gemini-api/docs/generate-content/thinking",
    "output": {
      "modes": [
        "default",
        "summary",
        "off"
      ],
      "note": "此预设使用 Gemini 原生接口，默认请求思考摘要。摘要是否返回仍由服务端决定；4router 可尝试 high 档位。不请求摘要不等于关闭思考。",
      "kind": "summary",
      "defaultMode": "summary"
    }
  },
  {
    "id": "deepseek_openai",
    "name": "DeepSeek · OpenAI Compatible",
    "protocol": "chat",
    "levels": [
      "low",
      "high",
      "max"
    ],
    "defaultLevel": "high",
    "source": "https://api-docs.deepseek.com/guides/thinking_mode/",
    "options": {
      "low": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "low"
      },
      "high": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "high"
      },
      "max": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "max"
      }
    },
    "omitTemperature": true,
    "note": "DeepSeek V4.1 Flash: low/high/max; V4 Pro: high/max. Choose only levels supported by your model.",
    "output": {
      "modes": [
        "default"
      ],
      "note": "思考模式通常自动通过 reasoning_content 返回推理文本，没有独立的摘要开关。不保证公开完整内部思维链。",
      "kind": "reasoning_text",
      "defaultMode": "default"
    }
  },
  {
    "id": "generic_effort",
    "name": "Generic · Reasoning Effort",
    "protocol": "chat",
    "levels": [
      "default",
      "none",
      "minimal",
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ],
    "defaultLevel": "default",
    "options": {
      "default": {},
      "none": {
        "reasoning_effort": "none"
      },
      "minimal": {
        "reasoning_effort": "minimal"
      },
      "low": {
        "reasoning_effort": "low"
      },
      "medium": {
        "reasoning_effort": "medium"
      },
      "high": {
        "reasoning_effort": "high"
      },
      "xhigh": {
        "reasoning_effort": "xhigh"
      },
      "max": {
        "reasoning_effort": "max"
      }
    },
    "omitTemperature": true,
    "note": "Same request field, different allowed levels. Kimi K3/K3.1: low/high/max; Grok 4.6/4.7: low/medium/high/xhigh; Meta Muse: minimal/low/medium/high/xhigh (max only for Muse Wonder 1.0 / Spark 1.3, not Contributor). OpenAI: model-dependent; GPT-6 Astra rejects none; GPT-6.1 Sol rejects none/minimal. default omits effort. Temperature is omitted for compatibility. Not a Llama preset.",
    "sources": [
      "https://developers.openai.com/api/docs/guides/reasoning",
      "https://developers.openai.com/api/docs/guides/deployment-checklist",
      "https://docs.x.ai/developers/model-capabilities/text/reasoning",
      "https://dev.meta.ai/docs/reasoning",
      "https://platform.moonshot.ai/docs/api/chat"
    ],
    "output": {
      "modes": [
        "default"
      ],
      "note": "同一强度字段不代表同一输出能力：Kimi 通常返回推理文本；OpenAI 和 Meta 外部 Chat Completions 不公开内部推理；Grok 按模型和接口而定。不能把 Responses 的摘要参数用于此通用预设。",
      "kind": "provider_defined",
      "defaultMode": "default"
    }
  },
  {
    "id": "generic_thinking_toggle",
    "name": "Generic · Thinking Toggle",
    "protocol": "chat",
    "levels": [
      "default",
      "enabled",
      "disabled"
    ],
    "defaultLevel": "default",
    "options": {
      "default": {},
      "enabled": {
        "thinking": {
          "type": "enabled"
        }
      },
      "disabled": {
        "thinking": {
          "type": "disabled"
        }
      }
    },
    "omitTemperature": true,
    "note": "MiMo V2.6, Kimi K2.6 and switchable GLM 4.x use thinking.type. No intensity levels. Not for always-thinking Kimi K2.7 Code / K3 or GLM 5.3. Temperature is omitted; the service chooses its mode-specific value.",
    "sources": [
      "https://mimo.mi.com/docs/en-US/api/chat/openai-api",
      "https://platform.moonshot.ai/docs/api/chat",
      "https://docs.z.ai/api-reference/llm/chat-completion"
    ],
    "output": {
      "modes": [
        "default"
      ],
      "note": "MiMo、Kimi K2.6、GLM 的思考文本通常随思考模式自动返回；此通用预设没有独立摘要开关。",
      "kind": "reasoning_text",
      "defaultMode": "default"
    }
  },
  {
    "id": "qwen_openai",
    "name": "Qwen 3.8 · OpenAI Compatible",
    "protocol": "chat",
    "levels": [
      "default",
      "enabled",
      "disabled",
      "low",
      "medium",
      "xhigh",
      "budget"
    ],
    "defaultLevel": "default",
    "options": {
      "default": {},
      "enabled": {
        "enable_thinking": true
      },
      "disabled": {
        "enable_thinking": false
      },
      "low": {
        "enable_thinking": true,
        "reasoning_effort": "low"
      },
      "medium": {
        "enable_thinking": true,
        "reasoning_effort": "medium"
      },
      "xhigh": {
        "enable_thinking": true,
        "reasoning_effort": "xhigh"
      },
      "budget": {
        "enable_thinking": true
      }
    },
    "omitTemperature": false,
    "note": "Qwen 3.8: low/medium/xhigh, or an exclusive thinking token budget (0–262144). Never send effort and budget together. Server defaults: xhigh / 131072 tokens; 0 budget is not the disabled switch. Existing default mode follows the service.",
    "sources": [
      "https://help.aliyun.com/en/model-studio/qwen-api-via-openai-chat-completions"
    ],
    "output": {
      "modes": [
        "default"
      ],
      "note": "思考模式通常自动通过 reasoning_content 返回推理文本；不额外发送摘要参数。",
      "kind": "reasoning_text",
      "defaultMode": "default"
    },
    "budget": {
      "min": 0,
      "max": 262144,
      "default": 131072,
      "field": "thinking_budget"
    }
  },
