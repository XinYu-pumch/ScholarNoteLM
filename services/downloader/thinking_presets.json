[
  {
    "id": "gemini4_openai",
    "name": "Gemini 4 · OpenAI Compatible",
    "protocol": "chat",
    "levels": [
      "low",
      "medium",
      "high"
    ],
    "defaultLevel": "medium",
    "source": "https://ai.google.dev/gemini-api/docs/openai#thinking",
    "options": {
      "low": {
        "reasoning_effort": "low"
      },
      "medium": {
        "reasoning_effort": "medium"
      },
      "high": {
        "reasoning_effort": "high"
      }
    }
  },
  {
    "id": "gemini4_native",
    "name": "Gemini 4 · Native",
    "protocol": "google",
    "levels": [
      "low",
      "medium",
      "high"
    ],
    "defaultLevel": "medium",
    "source": "https://ai.google.dev/gemini-api/docs/generate-content/thinking"
  },
  {
    "id": "deepseek_openai",
    "name": "DeepSeek · OpenAI Compatible",
    "protocol": "chat",
    "levels": [
      "low",
      "high",
      "max"
    ],
    "defaultLevel": "high",
    "source": "https://api-docs.deepseek.com/guides/thinking_mode/",
    "options": {
      "low": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "low"
      },
      "high": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "high"
      },
      "max": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "max"
      }
    },
    "omitTemperature": true,
    "note": "DeepSeek V4.1 Flash: low/high/max; V4 Pro: high/max. Choose only levels supported by your model."
  },
  {
    "id": "generic_effort",
    "name": "Generic · Reasoning Effort",
    "protocol": "chat",
    "levels": [
      "default",
      "none",
      "minimal",
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ],
    "defaultLevel": "default",
    "options": {
      "default": {},
      "none": {
        "reasoning_effort": "none"
      },
      "minimal": {
        "reasoning_effort": "minimal"
      },
      "low": {
        "reasoning_effort": "low"
      },
      "medium": {
        "reasoning_effort": "medium"
      },
      "high": {
        "reasoning_effort": "high"
      },
      "xhigh": {
        "reasoning_effort": "xhigh"
      },
      "max": {
        "reasoning_effort": "max"
      }
    },
    "omitTemperature": true,
    "note": "Same request field, different allowed levels. Kimi K3/K3.1: low/high/max; Grok 4.6/4.7: low/medium/high/xhigh; Meta Muse: minimal/low/medium/high/xhigh (max only for Muse Wonder 1.0 / Spark 1.3, not Contributor). OpenAI: model-dependent; GPT-6 Astra rejects none; GPT-6.1 Sol rejects none/minimal. default omits effort. Temperature is omitted for compatibility. Not a Llama preset.",
    "sources": [
      "https://developers.openai.com/api/docs/guides/reasoning",
      "https://developers.openai.com/api/docs/guides/deployment-checklist",
      "https://docs.x.ai/developers/model-capabilities/text/reasoning",
      "https://dev.meta.ai/docs/reasoning",
      "https://platform.moonshot.ai/docs/api/chat"
    ]
  },
  {
    "id": "generic_thinking_toggle",
    "name": "Generic · Thinking Toggle",
    "protocol": "chat",
    "levels": [
      "default",
      "enabled",
      "disabled"
    ],
    "defaultLevel": "default",
    "options": {
      "default": {},
      "enabled": {
        "thinking": {
          "type": "enabled"
        }
      },
      "disabled": {
        "thinking": {
          "type": "disabled"
        }
      }
    },
    "omitTemperature": true,
    "note": "MiMo V2.6, Kimi K2.6 and switchable GLM 4.x use thinking.type. No intensity levels. Not for always-thinking Kimi K2.7 Code / K3 or GLM 5.3. Temperature is omitted; the service chooses its mode-specific value.",
    "sources": [
      "https://mimo.mi.com/docs/en-US/api/chat/openai-api",
      "https://platform.moonshot.ai/docs/api/chat",
      "https://docs.z.ai/api-reference/llm/chat-completion"
    ]
  },
  {
    "id": "qwen_openai",
    "name": "Qwen 3.8 · OpenAI Compatible",
    "protocol": "chat",
    "levels": [
      "default",
      "enabled",
      "disabled",
      "low",
      "medium",
      "xhigh"
    ],
    "defaultLevel": "default",
    "options": {
      "default": {},
      "enabled": {
        "enable_thinking": true
      },
      "disabled": {
        "enable_thinking": false
      },
      "low": {
        "enable_thinking": true,
        "reasoning_effort": "low"
      },
      "medium": {
        "enable_thinking": true,
        "reasoning_effort": "medium"
      },
      "xhigh": {
        "enable_thinking": true,
        "reasoning_effort": "xhigh"
      }
    },
    "omitTemperature": false,
    "note": "Qwen 3.8: low/medium/xhigh. Earlier hybrid Qwen models may support only enabled/disabled. enable_thinking is sent at the top level, not inside extra_body. default follows the service.",
    "sources": [
      "https://help.aliyun.com/en/model-studio/qwen-api-via-openai-chat-completions"
    ]
  },
  {
    "id": "glm_openai",
    "name": "GLM 5.2 / 5.3 · OpenAI Compatible",
    "protocol": "chat",
    "levels": [
      "default",
      "low",
      "high",
      "max"
    ],
    "defaultLevel": "default",
    "options": {
      "default": {},
      "low": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "low"
      },
      "high": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "high"
      },
      "max": {
        "thinking": {
          "type": "enabled"
        },
        "reasoning_effort": "max"
      }
    },
    "omitTemperature": false,
    "note": "GLM 5.3 / 5.3 Flash: low/high/max; GLM 5.2: high/max. Default effort: max. GLM 5.3 cannot disable thinking. Same thinking fields as DeepSeek, but temperature and defaults differ.",
    "sources": [
      "https://docs.z.ai/api-reference/llm/chat-completion"
    ]
  }
]
