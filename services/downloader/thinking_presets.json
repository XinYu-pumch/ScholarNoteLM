      "https://platform.claude.com/docs/en/models/overview"
    ],
    "note": "Uses /messages, not Chat Completions. Opus 5.5 always thinks; default effort: medium. The required max_tokens uses the published 128,000 output ceiling. Relays must support Messages.",
    "output": {
      "modes": [
        "default",
        "summary",
        "off"
      ],
      "defaultMode": "summary",
      "kind": "summary",
      "note": "显式请求摘要使用 thinking.display=summarized；不请求摘要使用 omitted，不会关闭思考。服务端默认不发送 display。"
    },
    "maxOutputTokens": 128000
  },
